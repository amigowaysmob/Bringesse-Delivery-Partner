require 'json'
require 'fileutils'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'

prepare_react_native_project!

target 'bringessedelivery_partner' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => false
  )

  # ----------------------
  # Firebase with modular headers
  # ----------------------
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true

  pod 'FirebaseAuth', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true

  pod 'FirebaseFirestore', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true

  pod 'FirebaseAnalytics', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  # ----------------------
  # Google Maps
  # ----------------------
  pod 'GoogleMaps', '~> 8.4'
  pod 'GooglePlaces', '~> 8.4'

  # ----------------------
  # React Native Maps
  # ----------------------
  pod 'react-native-maps', :path => '../node_modules/react-native-maps'

  # ----------------------
  # HyperSDK (XCFramework)
  # ----------------------
  # pod 'HyperSDK', :path => '../node_modules/HyperSDK'

  # ----------------------
  # Post install fixes
  # ----------------------
  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Exclude arm64 for simulator (M1/M2)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end

    # Fix HyperSDK xcframework headers
    installer.pods_project.targets.each do |target|
      if target.name == 'HyperSDK'
        target.build_configurations.each do |config|
          # Framework search path
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '$(PODS_ROOT)/HyperSDK/HyperSDK.xcframework'

          # Library search path
          config.build_settings['LIBRARY_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['LIBRARY_SEARCH_PATHS'] << '$(PODS_ROOT)/HyperSDK/HyperSDK.xcframework'

          # Expose all headers
          target.build_phases.each do |phase|
            next unless phase.respond_to?(:files)
            phase.files.each do |file|
              file.settings ||= {}
              file.settings['ATTRIBUTES'] = ['Public']
            end
          end
        end
      end
    end
  end
end
